  "keyFeatures": [
    "Swell AI assistant for drafting and editing email campaigns",
    "Brand workspace management with colors, fonts, logos, and voice",
    "Contact import, segmentation, and RFM customer scoring",
    "Drag-and-drop campaign editor with device preview and HTML view",
    "Campaign scheduling, A/B testing, and delivery reports",
    "Automation workflows with triggers, conditions, and delays",
    "Hosted newsletter pages and signup forms with consent management",
    "CRM with companies, deals, and pipeline stages",
    "Meeting booking pages and live chat widget",
    "Transactional email templates and API",
    "Local stdio MCP server with 11 tools for AI client integration",
    "Brand Context API for reading workspace brand data",
    "Google OAuth and password authentication (12-character minimum)",
    "Workspace roles: owner, admin, editor, viewer",
    "Image library with upload and public URL support",
    "Design references, brand memories, and persistent AI instructions",
    "Campaign tags, preflight validation, and test sends",
    "PayPal-based subscription billing"
  ],
